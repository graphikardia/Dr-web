# =============================================================================
# Dr. Darshana Website - Environment Variables
# Add these in Vercel Dashboard → Settings → Environment Variables
# =============================================================================

# -------------------
# AI Chatbot (Required)
# -------------------
GROQ_API_KEY=           # Get free at https://console.groq.com
GROQ_MODEL=llama-3.3-70b-versatile

# -------------------
# Web Search (Optional - for health questions)
# Uses Tavily (free 1000 searches/month)
# -------------------
SEARCH_API_KEY=         # Get free at https://tavily.com
# or use:
# TAVILY_API_KEY=

# -------------------
# Server Configuration
# -------------------
PING_MESSAGE=ping
ALLOWED_ORIGINS=        # Comma-separated: https://yoursite.vercel.app

# -------------------
# Lead Capture (Optional)
# -------------------
# One Google Apps Script web app URL handles every form on the site. The
# script routes submissions to separate tabs in one spreadsheet:
#   "Chatbot Leads"  <- AI assistant
#   "Contact Leads"  <- contact page + home page help form
# The tabs and their headers are created automatically on first submission.
# Script source: public/apps_script_leads.gs
VITE_GOOGLE_SHEET_URL=